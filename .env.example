TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_ALLOWED_CHAT_ID=123456789
TELEGRAM_LONG_POLL_TIMEOUT_SEC=20
SESSION_PATH=data/session.json
# Required: set this to your real Obsidian vault path.
OBSIDIAN_VAULT_PATH=D:/path/to/your/ObsidianVault
OBSIDIAN_LANGUAGE_ROOT=Language
OBSIDIAN_JOURNAL_DIR=Journal
OBSIDIAN_JAPANESE_DIR=Japanese
OBSIDIAN_ENGLISH_DIR=English
OBSIDIAN_MISTAKES_DIR=Mistakes
OBSIDIAN_EXPRESSIONS_DIR=Expressions
LOG_LEVEL=info

# Optional proxy settings for local Telegram / Codex connectivity.
# dotenv will load them into process.env for the main app and child processes.
HTTP_PROXY=http://127.0.0.1:7897
HTTPS_PROXY=http://127.0.0.1:7897
NO_PROXY=localhost,127.0.0.1
